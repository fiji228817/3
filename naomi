local function update_esp()
    local E = Config.esp
    local my_hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local my_team = LocalPlayer.Team

    for plr, o in pairs(esp_pool) do
        local show = false
        local char = plr.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")

        if E.enabled and char and hum and hum.Health > 0 and hrp and head
           and not (E.team_check and my_team and plr.Team and plr.Team == my_team) then

            local dist = my_hrp and (hrp.Position - my_hrp.Position).Magnitude or 0
            if dist <= E.max_distance then
                local topV, topOn = CurrentCamera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.6, 0))
                local botV, botOn = CurrentCamera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.2, 0))
                if (topOn or botOn) and topV.Z > 0 and botV.Z > 0 then
                    show = true
                    local topY  = topV.Y
                    local botY  = botV.Y
                    local height = botY - topY
                    local width  = height * 0.55
                    local cx     = (topV.X + botV.X) * 0.5
                    local x      = cx - width * 0.5
                    local y      = topY

                    if E.box.enabled then
                        o.box_outline.Size     = Vector2.new(width, height)
                        o.box_outline.Position = Vector2.new(x, y)
                        o.box_outline.Visible  = true

                        o.box.Size     = Vector2.new(width, height)
                        o.box.Position = Vector2.new(x, y)
                        o.box.Color    = E.box.color
                        o.box.Visible  = true
                    else
                        o.box.Visible = false
                        o.box_outline.Visible = false
                    end

                    if E.name.enabled then
                        local label = plr.DisplayName ~= "" and plr.DisplayName or plr.Name
                        o.name.Text     = label
                        o.name.Position = Vector2.new(cx, y - 16)
                        o.name.Color    = E.name.color
                        o.name.Visible  = true
                    else
                        o.name.Visible = false
                    end

                    if E.distance.enabled then
                        o.distance.Text     = string.format("[%d m]", math.floor(dist))
                        o.distance.Position = Vector2.new(cx, y + height + 2)
                        o.distance.Color    = E.distance.color
                        o.distance.Visible  = true
                    else
                        o.distance.Visible = false
                    end

                    if E.healthbar.enabled then
                        local hp_ratio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                        local bar_x = x - 5
                        o.hp_bg.From = Vector2.new(bar_x, y - 1)
                        o.hp_bg.To   = Vector2.new(bar_x, y + height + 1)
                        o.hp_bg.Visible = true

                        o.hp.From = Vector2.new(bar_x, y + height * (1 - hp_ratio))
                        o.hp.To   = Vector2.new(bar_x, y + height)
                        o.hp.Color = E.healthbar.color
                        o.hp.Visible = true
                    else
                        o.hp.Visible = false
                        o.hp_bg.Visible = false
                    end

                    if E.headdot.enabled then
                        local hv, hon = CurrentCamera:WorldToViewportPoint(head.Position)
                        if hon then
                            local scale = head.Size.Y
                            local depth = math.max(1, hv.Z)
                            local radius = (scale * 50) / depth
                            o.head_outline.Radius   = radius + 1
                            o.head_outline.Position = Vector2.new(hv.X, hv.Y)
                            o.head_outline.Visible  = true
                            o.head.Radius   = radius
                            o.head.Position = Vector2.new(hv.X, hv.Y)
                            o.head.Color    = E.headdot.color
                            o.head.Visible  = true
                        else
                            o.head.Visible = false
                            o.head_outline.Visible = false
                        end
                    else
                        o.head.Visible = false
                        o.head_outline.Visible = false
                    end
                end
            end
        end
        if not show then hide_esp(o) end
    end
end

