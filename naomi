local function updateFov()
    local show = Config.silent.showfov
    fov_fill.Visible    = show
    fov_outline.Visible = show
    if not show then return end

    local vp = CurrentCamera.ViewportSize
    local center = Vector2.new(vp.X * 0.5, vp.Y * 0.5)
    fov_fill.Position   = center
    fov_fill.Radius     = Config.silent.fov
    fov_fill.Color      = Config.silent.fovcolor
    fov_outline.Position = center
    fov_outline.Radius   = Config.silent.fov + 1
end

local esp_pool = {}

local function new_drawing(kind, props)
    local d = Drawing.new(kind)
    for k, v in pairs(props) do d[k] = v end
    return d
end

local function create_esp(plr)
    if esp_pool[plr] then return end
    local o = {}

    o.box_outline = new_drawing("Square", {
        Thickness = 3, Filled = false, Visible = false,
        Color = Color3.fromRGB(0, 0, 0), Transparency = 1,
    })
    o.box = new_drawing("Square", {
        Thickness = 1, Filled = false, Visible = false,
        Color = Color3.fromRGB(255, 255, 255), Transparency = 1,
    })

    o.name = new_drawing("Text", {
        Size = 16, Center = true, Outline = true, Visible = false,
        Font = 41, Color = Color3.fromRGB(255, 255, 255),
        OutlineColor = Color3.fromRGB(0, 0, 0), Transparency = 1,
    })
    o.distance = new_drawing("Text", {
        Size = 16, Center = true, Outline = true, Visible = false,
        Font = 41, Color = Color3.fromRGB(255, 255, 255),
        OutlineColor = Color3.fromRGB(0, 0, 0), Transparency = 1,
    })

    o.hp_bg = new_drawing("Line", {
        Thickness = 3, Visible = false,
        Color = Color3.fromRGB(0, 0, 0), Transparency = 1,
    })
    o.hp = new_drawing("Line", {
        Thickness = 1, Visible = false,
        Color = Color3.fromRGB(0, 255, 0), Transparency = 1,
    })

    o.head_outline = new_drawing("Circle", {
        Thickness = 3, NumSides = 20, Filled = false, Visible = false,
        Color = Color3.fromRGB(0, 0, 0), Transparency = 1,
    })
    o.head = new_drawing("Circle", {
        Thickness = 1, NumSides = 20, Filled = false, Visible = false,
        Color = Color3.fromRGB(255, 255, 255), Transparency = 1,
    })

    esp_pool[plr] = o
end

local function remove_esp(plr)
    local o = esp_pool[plr]
    if not o then return end
    for _, d in pairs(o) do pcall(function() d:Remove() end) end
    esp_pool[plr] = nil
end

local function hide_esp(o)
    o.box.Visible = false
    o.box_outline.Visible = false
    o.name.Visible = false
    o.distance.Visible = false
    o.hp.Visible = false
    o.hp_bg.Visible = false
    o.head.Visible = false
    o.head_outline.Visible = false
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then create_esp(p) end
end
Players.PlayerAdded:Connect(function(p) if p ~= LocalPlayer then create_esp(p) end end)
