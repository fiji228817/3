handler.getAim = function(origin, maxDist)
    if Config.silent.enabled and sa.target.part then
        local part = sa.target.part
        local pos  = part.Position
        if Config.silent.prediction.enabled then
            local vel = part.AssemblyLinearVelocity
            local p   = Config.silent.prediction
            pos = pos + Vector3.new(vel.X * p.x, vel.Y * p.y, vel.Z * p.z)
        end
        local offset   = pos - origin
        local distance = offset.Magnitude
        return offset.Unit, math.min(distance, maxDist or 200)
    end
    return oldGetAim(origin, maxDist)
end

local idx
idx = hookmetamethod(game, "__index", function(self, key)
    if not checkcaller() and self == mouse and Config.silent.enabled and sa.target.part then
        if key == "Hit" then
            local part = sa.target.part
            local vel  = part.AssemblyLinearVelocity
            local p    = Config.silent.prediction
            local pos  = part.Position + Vector3.new(vel.X * p.x, vel.Y * p.y, vel.Z * p.z)
            return CFrame.new(pos)
        elseif key == "Target" then
            return sa.target.part
        end
    end
    return idx(self, key)
end)

