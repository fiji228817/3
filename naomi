local target
RunService.RenderStepped:Connect(function()
    if Config.MouseLockEnabled and Config.State then
        if not (target and target.Parent) then
            local best = nil
            local bestD = math.huge
            local mp = UserInputService:GetMouseLocation()
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    local hum = plr.Character:FindFirstChildOfClass('Humanoid')
                    if hum and hum.Health > 0 then
                        local part = plr.Character:FindFirstChild(Config.HitPart) or plr.Character.PrimaryPart
                        if part then
                            local sp = CurrentCamera:WorldToViewportPoint(part.Position)
                            local d  = (Vector2.new(mp.X, mp.Y) - Vector2.new(sp.X, sp.Y)).Magnitude
                            if d < bestD then best, bestD = part, d end
                        end
                    end
                end
            end
            target = best
        end

        if target and target.Parent then
            local vel = typeof(target.AssemblyLinearVelocity) == 'Vector3'
                and target.AssemblyLinearVelocity or target.Velocity
            local worldPos  = target.Position + (vel * Config.Prediction)
            local camRight  = CurrentCamera.CFrame.RightVector
            local offsetVec = (camRight * Config.LeftOffset) + Vector3.new(0, Config.UpOffset, 0)
            local finalPos  = worldPos + offsetVec
            local sp, onScreen = CurrentCamera:WorldToViewportPoint(finalPos)
            if onScreen then
                local mp    = UserInputService:GetMouseLocation()
                local moveX = (sp.X - mp.X) * Config.Smoothness
                local moveY = (sp.Y - mp.Y) * Config.Smoothness
                if math.abs(moveX) > 0.01 or math.abs(moveY) > 0.01 then
                    pcall(function() mousemoverel(moveX, moveY) end)
                end
            end
        end
    else
        target = nil
    end

    if Config.HipHeightEnabled then
        local char = LocalPlayer.Character
        local hum  = char and char:FindFirstChildOfClass('Humanoid')
        if hum then hum.HipHeight = Config.HipHeightValue end
    end

    if Config.Walkspeed.Enabled and Config.Walkspeed.Active then
        local char = LocalPlayer.Character
        local hum  = char and char:FindFirstChildOfClass('Humanoid')
        if hum then hum.WalkSpeed = Config.Walkspeed.Speed end
